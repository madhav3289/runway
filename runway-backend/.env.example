# Copy to .env (never commit .env)
PORT=4000
NODE_ENV=development

# Postgres (local, or the connection string Neon/Supabase gives you)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/runway

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Flask simulation service
SIM_URL=http://localhost:5001
# Shared secret between API and sim service. Set the SAME value on both when deployed.
SIM_API_KEY=
# Free tiers cold-start slowly; give the sim service time to wake up
SIM_TIMEOUT_MS=45000

# Comma-separated origins allowed to call the API. Entries may use a wildcard subdomain, e.g. https://*.lovable.app
CORS_ORIGIN=http://localhost:5173,http://localhost:8080,https://*.lovable.app,https://*.lovableproject.com

# Read-only demo account used by POST /api/auth/demo
DEMO_EMAIL=demo@runway.app
DEMO_PASSWORD=change-me-demo-password
